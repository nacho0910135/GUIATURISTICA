        loading: 'Traffic: Loading…',
        noData: 'Traffic: No data',
        fluid: 'Traffic: Smooth',
        slow: 'Traffic: Slow',
        heavy: 'Traffic: Heavy',
        congested: 'Traffic: Congested',
        approx: 'Approx delay'
      };
      
      if (!scheduleId){
        // Sin identificador de horario válido: ocultar completamente el widget
        container.style.display = 'none';
        return;
      }

      function setChip(state, text){
        chipText.textContent = text;
        chip.classList.remove('badge-secondary','badge-success','badge-info','badge-warning','badge-danger');
        chip.classList.add('badge');
        if (state) chip.classList.add(state);
      }

      function render(data){
        if (!data){
          // Sin datos de tráfico: ocultar todo el bloque
          container.style.display = 'none';
          if (inlineTxt) inlineTxt.textContent = '';
          if (btnRefresh) btnRefresh.style.display = '';
          return;
        }

        container.style.display = '';

        var delay = parseInt(data.delay_minutes||0,10);
        if (isNaN(delay) || delay < 0) delay = 0;

        var clsName;
        var label;

        // Escala LATAM: verde (<=4), naranja (5-10), rojo (>10)
        if (delay > 10) {
          clsName = 'badge-danger';
          label = L.congested;
        } else if (delay >= 5) {
          clsName = 'badge-warning';
          label = L.slow;
        } else {
          clsName = 'badge-success';
          label = L.fluid;
        }

        setChip(clsName, label);
        if (inlineTxt) inlineTxt.textContent = '— ' + L.approx + ': ' + delay + ' min';
        detail.style.display = 'none';
        if (btnRefresh) btnRefresh.style.display = '';
      }

      function fetchTraffic(){
        container.style.display = '';
        setChip('badge-secondary', L.loading);
        detail.style.display='none';
        var safety = setTimeout(function(){
          try{
            // Si sigue cargando demasiado tiempo, ocultar el widget
            container.style.display = 'none';
          }catch(e){}
        }, 6000);
        var controller = (window.AbortController) ? new AbortController() : null;
        var t = null;
        if (controller){ t = setTimeout(function(){ try{ controller.abort(); }catch(e){} }, 8000); }
        var csrfTag = document.querySelector('meta[name="csrf-token"]');
        var csrf = csrfTag ? csrfTag.getAttribute('content') : '';
        fetch(window.location.origin + '/api/traffic/bus', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'X-CSRF-TOKEN': csrf },
          credentials: 'same-origin',
          body: JSON.stringify({ schedules: [scheduleId] }),
          signal: controller ? controller.signal : undefined
        }).then(function(r){ if (t) clearTimeout(t); if (safety) clearTimeout(safety); if (!r.ok){ throw new Error('http'); } return r.json(); })
          .then(function(res){
            if (safety) clearTimeout(safety);
            if (!res || res.success!==true){ throw new Error('bad'); }
            var data = res.data || {};
            var per = data[''+scheduleId] || data[scheduleId] || null;
            if (per == null){
              var ks = Object.keys(data||{});
              if (ks.length===1){ per = data[ks[0]]; }
            }
            render(per);
          })
          .catch(function(err){
            if (safety) clearTimeout(safety);
            // En error, ocultar el widget de tráfico
            container.style.display = 'none';
          });
      }

      chip.addEventListener('click', function(){ if (detail.style.display==='none'){ detail.style.display=''; } else { detail.style.display='none'; } });
      if (btnRefresh){ btnRefresh.addEventListener('click', function(){ fetchTraffic(); }); }
      fetchTraffic();
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', __traffic_init);
      } else {
        __traffic_init();
      }
    })();
    </script>
