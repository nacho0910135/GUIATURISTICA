                        out=out.replace(/(?:<p>)?\s*(?:Puedes|Puede|Consulta|Puedes\s+ver)[^<]*?horario\s+completo\s+en\s+/giu,'');
                        // English variant
                        out=out.replace(/(?:<p>)?\s*You\s+can\s+view\s+the\s+full\s+schedule\s+at\s+/giu,'');
                        // Collapse empty paragraphs generated after removal
                        out=out.replace(/<p>\s*<\/p>/g,'');
                        return out;
                    }catch(e){return html}
                }

                function sanitizeBotHtml(html){
                    var wrapper=document.createElement('div');
                    wrapper.innerHTML=String(html||'');

                    var blocked=wrapper.querySelectorAll('script,style,iframe,object,embed,link,meta');
                    blocked.forEach(function(el){ el.remove(); });

                    wrapper.querySelectorAll('*').forEach(function(el){
                        Array.from(el.attributes).forEach(function(attr){
                            var name=(attr.name||'').toLowerCase();
                            var value=String(attr.value||'');
                            if(name.indexOf('on')===0){ el.removeAttribute(attr.name); }
                            if((name==='href' || name==='src') && /^\s*javascript:/i.test(value)){
                                el.removeAttribute(attr.name);
                            }
                        });
                    });

                    return wrapper.innerHTML;
                }

                // Render bot HTML (with avatar + bubble)
                function appendBotHtml(html){
                    if(!messages) return;
                    var wrap=document.createElement('div');wrap.className='yv-message';
                    var img=document.createElement('img');img.className='chat-avatar bot-avatar';img.src='/img/frontend/bot-avatar-small.png';
                    var bub=document.createElement('div');bub.className='yv-bubble yv-bot';
                    var clean = sanitizeBotHtml(sanitizeBotReply(html));
                    try{bub.innerHTML=clean;}catch(e){bub.textContent=clean;}
                    wrap.appendChild(img);wrap.appendChild(bub);
                    messages.appendChild(wrap);messages.scrollTop=messages.scrollHeight;
                }

                // Render plain text message (user or bot)
                function appendMsg(text, who){
                    if(!messages) return;
                    var wrap=document.createElement('div');wrap.className='yv-message '+(who==='me'?'yv-me':'');
                    var img=document.createElement('img');img.className='chat-avatar '+(who==='me'?'user-avatar':'bot-avatar');
                    img.src=(who==='me'?'/img/frontend/bot-avatar-user-small.png':'/img/frontend/bot-avatar-small.png');
                    var bub=document.createElement('div');bub.className='yv-bubble '+(who==='me'?'yv-me':'yv-bot');
                    bub.textContent=(text||'');
                    wrap.appendChild(img);wrap.appendChild(bub);
                    messages.appendChild(wrap);messages.scrollTop=messages.scrollHeight;
                }
                function send(){
                    var txt=(input.value||'').trim();if(!txt){return;}
                    var ctx=pageContext();
                    // On generic pages, use legacy /chatbot page
                    if(ctx.type!=='bus' && ctx.type!=='travel'){
                        var q=encodeURIComponent(txt);
                        window.location.href='/chatbot'+(q?('?m='+q):'');
                        return;
                    }
                    var cs=updateSummaryOnSend(txt, ctx);
                    appendMsg(txt,'me'); input.value=''; sendBtn.disabled=true;
                    if(typing) typing.style.display='flex';
                    $.ajax({
                        url:'/api/chatbot/contextual',
                        method:'POST',
                        contentType:'application/json',
                        data:JSON.stringify({message:txt,page:ctx,client_summary:cs}),
                        headers:{'X-Requested-With':'XMLHttpRequest'},
                    }).done(function(res){
                        var reply=(res&&res.reply)?res.reply:'No pude procesar tu solicitud.';
                        appendBotHtml(reply);
                    }).fail(function(){
                        appendMsg('Ocurrió un error. Intenta nuevamente.','bot');
                    }).always(function(){sendBtn.disabled=false; if(typing) typing.style.display='none';});
                }

                function openWebChat(){
                    setNudgeState(false);
                    var ctx=pageContext();
                    if(ctx.type!=='bus' && ctx.type!=='travel'){
                        window.location.href='/chatbot';
                        return;
                    }
                    if(modal.style.display==='none'||!modal.style.display){
                        modal.style.display='flex';
                        if(launcherToggle){ launcherToggle.setAttribute('aria-expanded','true'); }
                        setSuggestions();
                        setTimeout(function(){input&&input.focus();},50);
                    } else {
                        modal.style.display='none';
                        if(launcherToggle){ launcherToggle.setAttribute('aria-expanded','false'); }
                    }
                }

                if(launcherToggle){launcherToggle.addEventListener('click',function(e){
                    e.preventDefault();
                    e.stopPropagation();
                    handleUserActivity();
                    openWebChat();
                });}
                if(closeBtn){closeBtn.addEventListener('click',function(){
                    handleUserActivity();
                    setNudgeState(false);
                    modal.style.display='none';
                    if(launcherToggle){ launcherToggle.setAttribute('aria-expanded','false'); }
                });}
                if(sendBtn){sendBtn.addEventListener('click',function(){ handleUserActivity(); send(); });}
                if(input){input.addEventListener('keypress',function(e){ if(e.key==='Enter'){ handleUserActivity(); e.preventDefault(); send(); }});} 

                document.addEventListener('keydown',function(e){
                    handleUserActivity();
                    if(e.key==='Escape'){
                        setNudgeState(false);
                        if(modal){ modal.style.display='none'; }
                        if(launcherToggle){ launcherToggle.setAttribute('aria-expanded','false'); }
                    }
                });

                document.addEventListener('pointerdown', handleUserActivity, {passive:true});
                document.addEventListener('touchstart', handleUserActivity, {passive:true});
                document.addEventListener('scroll', handleUserActivity, {passive:true});

                // Initialize suggestions on load if opened later
                setSuggestions();
                // scheduleNudge(); // Disabled: annoying popup in mobile
                scheduleLauncherAutoHide();
            })();
        </script>

