    var timer;
    var timeout = 600;
    $("#searchterm").keyup(function(e){
        clearTimeout(timer);
        var len = this.value.length;
        if(len > 4) {
            timer = setTimeout(function(){
                var q = $("#searchterm").val();
                $("#searchLoader").css("display", "block");
                $.getJSON("/autocomplete",
                    {
                        srsearch: q,
                        action: "query",
                        list: "search",
                        format: "json"
                    },
                    function (data) {
                        $("#searchLoader").css("display", "none");
                        $("#results").empty();
                        $.each(data, function (i, item) {
                            if(item.id == 999999999){
                                $("#results").append("<div class='mt-3 mb-2'><h5><a href='/search?s=" + encodeURIComponent(item.slug) + "'>" + item.title + "</a></h5></div>");
                            }else if(item.id == 777){
                                $("#results").append("<div class='mt-3 mb-2'><h5><a href='" + item.slug + "' target='_blank''>" + item.title + "</a></h5></div>");
                            }else if(item.id == 333){
                                $("#results").append("<div class='mt-3 mb-2'><h5><a href='" + item.slug + "' target='_blank''>" + item.title + "</a></h5></div>");
                            }else{
                                $("#results").append("<div class='mt-3 mb-2'><h5><a href='/bus/" + encodeURIComponent(item.slug) + "'>" + item.title + "</a></h5></div>");
                              }

                        });

                    });
            }, timeout);
        }
    });

    window.setTimeout(function() {
        $("#favoriteAlert").fadeTo(1700, 0).slideUp(1600, function(){
            $(this).remove();
        });
    }, 6900);

    window.setTimeout(function() {
        $("#noticeAlert").fadeTo(1700, 0).slideUp(1600, function(){
