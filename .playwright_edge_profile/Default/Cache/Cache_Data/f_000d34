        <script type="aa32d375ea03ca068a79970f-text/javascript">
            (function(){
                var botWrap=document.getElementById('yv-help-bot-wrap');
                var launcher=document.getElementById('yv-help-launcher');
                var launcherToggle=document.getElementById('yv-help-toggle');
                var closeBtn=document.getElementById('yv-chat-close');
                var modal=document.getElementById('yv-chat-modal');
                var messages=document.getElementById('yv-chat-messages');
                var input=document.getElementById('yv-chat-text');
                var sendBtn=document.getElementById('yv-chat-send');
                var typing=document.getElementById('yv-typing');
                var sugg=document.getElementById('yv-chat-suggestions');
                var nudgeEl=document.getElementById('yv-help-nudge');
                var nudgeTimer=null;
                var nudgeHideTimer=null;
                var launcherHideTimer=null;

                function setLauncherVisibility(isVisible){
                    if(!launcher) return;
                    launcher.classList.toggle('yv-help-hidden', !isVisible);
                }

                function scheduleLauncherAutoHide(){
                    if(!launcher) return;
                    clearTimeout(launcherHideTimer);
                    launcherHideTimer=setTimeout(function(){
                        if(modal && modal.style.display==='flex'){
                            scheduleLauncherAutoHide();
                            return;
                        }
                        setNudgeState(false);
                        setLauncherVisibility(false);
                    }, 15000);
                }

                function handleUserActivity(){
                    setLauncherVisibility(true);
                    scheduleLauncherAutoHide();
                }

                function setNudgeState(isVisible){
                    if(!botWrap) return;
                    botWrap.classList.toggle('show-nudge', !!isVisible);
                }

                function hasShownNudge(){
                    try{return sessionStorage.getItem('yv_help_nudge_shown') === '1';}catch(e){return false;}
                }

                function markNudgeShown(){
                    try{sessionStorage.setItem('yv_help_nudge_shown','1');}catch(e){}
                }

                function pickNudgeMessage(){
                    if(!nudgeEl) return '';
                    var msgs=[
                        nudgeEl.dataset.nudge1,
                        nudgeEl.dataset.nudge2,
                        nudgeEl.dataset.nudge3,
                        nudgeEl.dataset.nudge4,
                        nudgeEl.dataset.nudge5
                    ].filter(function(m){ return !!(m && m.trim()); });
                    if(!msgs.length) return nudgeEl.textContent || '';
                    var idx=Math.floor(Math.random()*msgs.length);
                    return msgs[idx];
                }

                function scheduleNudge(){
                    if(!botWrap || !launcherToggle || hasShownNudge()) return;
                    clearTimeout(nudgeTimer);
                    clearTimeout(nudgeHideTimer);
                    nudgeTimer=setTimeout(function(){
                        if(modal && modal.style.display==='flex') return;
                        if(nudgeEl){ nudgeEl.textContent = pickNudgeMessage(); }
                        setNudgeState(true);
                        markNudgeShown();
                        nudgeHideTimer=setTimeout(function(){setNudgeState(false);}, 7000);
                    }, 5000);
                }

                // Client summary helpers (non-sensitive): name, summary, updated_at
                function loadSummary(){
                    try{var s=localStorage.getItem('yv_chat_summary');if(!s) return null;return JSON.parse(s);}catch(e){return null}
                }
                function saveSummary(obj){
                    try{localStorage.setItem('yv_chat_summary', JSON.stringify(obj));}catch(e){}
                }
                function updateSummaryOnSend(text, ctx){
                    var s=loadSummary()||{}; s.updated_at=Date.now();
                    if(typeof s.name!=='string'){ s.name=''; }
                    if(typeof s.summary!=='string'){ s.summary=''; }
                    var add=(text||'').trim(); if(add){ s.summary=(s.summary+' | '+add).slice(-240); }
                    s={ name:s.name, summary:s.summary, updated_at:s.updated_at };
                    saveSummary(s); return s;
                }

                function pageContext(){
                    var p=(window.location.pathname||'');
                    var parts=p.split('/').filter(Boolean);
                    var ctx={type:'',slug:'',url:window.location.href};
                    if(parts[0]==='bus' && parts[1]){ctx.type='bus';ctx.slug=decodeURIComponent(parts[1]);}
                    else if(parts[0]==='company' && parts[1]){ctx.type='company';ctx.slug=decodeURIComponent(parts[1]);}
                    else if(parts[0]==='travel' && parts[1] && parts[2]){ctx.type='travel';ctx.origin=decodeURIComponent(parts[1]);ctx.destination=decodeURIComponent(parts[2]);}
                    else if(p==='/'||p===''){ctx.type='home';}
                    else {ctx.type='page';}
                    return ctx;
                }

                function setSuggestions(){
                    if(!sugg) return;
                    var ctx=pageContext();
                    var chips=[];
                    if(ctx.type==='bus') chips=['Próxima salida','Precio','Paradas principales'];
                    else if(ctx.type==='travel') chips=['Rutas directas','Con transbordo','Precio aproximado'];
                    else chips=['Buscar ruta','Ayuda'];
                    sugg.innerHTML='';
                    chips.forEach(function(c){
                        var b=document.createElement('button');b.type='button';b.className='yv-chip';b.textContent=c; b.addEventListener('click',function(){ input.value=c; send(); });
                        sugg.appendChild(b);
                    });
                }

                // Sanitize redundant phrasing before CTAs while preserving anchors
                function sanitizeBotReply(html){
                    try{
                        var out=String(html);
                        // Remove leading phrasing up to the CTA mention (Spanish)
                        out=out.replace(/(?:<p>)?\s*(?:Puedes|Puede|Consulta|Puedes\s+ver)[^<]*?horario\s+completo\s+en\s+/giu,'');
                        // English variant
                        out=out.replace(/(?:<p>)?\s*You\s+can\s+view\s+the\s+full\s+schedule\s+at\s+/giu,'');
                        // Collapse empty paragraphs generated after removal
                        out=out.replace(/<p>\s*<\/p>/g,'');
                        return out;
                    }catch(e){return html}
                }

                function sanitizeBotHtml(html){
                    var wrapper=document.createElement('div');
                    wrapper.innerHTML=String(html||'');

                    var blocked=wrapper.querySelectorAll('script,style,iframe,object,embed,link,meta');
                    blocked.forEach(function(el){ el.remove(); });

                    wrapper.querySelectorAll('*').forEach(function(el){
                        Array.from(el.attributes).forEach(function(attr){
                            var name=(attr.name||'').toLowerCase();
                            var value=String(attr.value||'');
                            if(name.indexOf('on')===0){ el.removeAttribute(attr.name); }
                            if((name==='href' || name==='src') && /^\s*javascript:/i.test(value)){
                                el.removeAttribute(attr.name);
                            }
                        });
                    });

                    return wrapper.innerHTML;
                }

                // Render bot HTML (with avatar + bubble)
                function appendBotHtml(html){
                    if(!messages) return;
                    var wrap=document.createElement('div');wrap.className='yv-message';
                    var img=document.createElement('img');img.className='chat-avatar bot-avatar';img.src='/img/frontend/bot-avatar-small.png';
                    var bub=document.createElement('div');bub.className='yv-bubble yv-bot';
                    var clean = sanitizeBotHtml(sanitizeBotReply(html));
                    try{bub.innerHTML=clean;}catch(e){bub.textContent=clean;}
                    wrap.appendChild(img);wrap.appendChild(bub);
                    messages.appendChild(wrap);messages.scrollTop=messages.scrollHeight;
                }

                // Render plain text message (user or bot)
                function appendMsg(text, who){
                    if(!messages) return;
                    var wrap=document.createElement('div');wrap.className='yv-message '+(who==='me'?'yv-me':'');
                    var img=document.createElement('img');img.className='chat-avatar '+(who==='me'?'user-avatar':'bot-avatar');
                    img.src=(who==='me'?'/img/frontend/bot-avatar-user-small.png':'/img/frontend/bot-avatar-small.png');
                    var bub=document.createElement('div');bub.className='yv-bubble '+(who==='me'?'yv-me':'yv-bot');
                    bub.textContent=(text||'');
                    wrap.appendChild(img);wrap.appendChild(bub);
                    messages.appendChild(wrap);messages.scrollTop=messages.scrollHeight;
                }
                function send(){
                    var txt=(input.value||'').trim();if(!txt){return;}
                    var ctx=pageContext();
                    // On generic pages, use legacy /chatbot page
                    if(ctx.type!=='bus' && ctx.type!=='travel'){
                        var q=encodeURIComponent(txt);
                        window.location.href='/chatbot'+(q?('?m='+q):'');
                        return;
                    }
                    var cs=updateSummaryOnSend(txt, ctx);
                    appendMsg(txt,'me'); input.value=''; sendBtn.disabled=true;
                    if(typing) typing.style.display='flex';
                    $.ajax({
                        url:'/api/chatbot/contextual',
                        method:'POST',
                        contentType:'application/json',
                        data:JSON.stringify({message:txt,page:ctx,client_summary:cs}),
                        headers:{'X-Requested-With':'XMLHttpRequest'},
                    }).done(function(res){
                        var reply=(res&&res.reply)?res.reply:'No pude procesar tu solicitud.';
                        appendBotHtml(reply);
                    }).fail(function(){
                        appendMsg('Ocurrió un error. Intenta nuevamente.','bot');
                    }).always(function(){sendBtn.disabled=false; if(typing) typing.style.display='none';});
                }

                function openWebChat(){
                    setNudgeState(false);
                    var ctx=pageContext();
                    if(ctx.type!=='bus' && ctx.type!=='travel'){
                        window.location.href='/chatbot';
                        return;
                    }
                    if(modal.style.display==='none'||!modal.style.display){
                        modal.style.display='flex';
                        if(launcherToggle){ launcherToggle.setAttribute('aria-expanded','true'); }
                        setSuggestions();
                        setTimeout(function(){input&&input.focus();},50);
                    } else {
                        modal.style.display='none';
                        if(launcherToggle){ launcherToggle.setAttribute('aria-expanded','false'); }
                    }
                }

                if(launcherToggle){launcherToggle.addEventListener('click',function(e){
                    e.preventDefault();
                    e.stopPropagation();
                    handleUserActivity();
                    openWebChat();
                });}
                if(closeBtn){closeBtn.addEventListener('click',function(){
                    handleUserActivity();
                    setNudgeState(false);
                    modal.style.display='none';
                    if(launcherToggle){ launcherToggle.setAttribute('aria-expanded','false'); }
                });}
                if(sendBtn){sendBtn.addEventListener('click',function(){ handleUserActivity(); send(); });}
                if(input){input.addEventListener('keypress',function(e){ if(e.key==='Enter'){ handleUserActivity(); e.preventDefault(); send(); }});} 

                document.addEventListener('keydown',function(e){
                    handleUserActivity();
                    if(e.key==='Escape'){
                        setNudgeState(false);
                        if(modal){ modal.style.display='none'; }
                        if(launcherToggle){ launcherToggle.setAttribute('aria-expanded','false'); }
                    }
                });

                document.addEventListener('pointerdown', handleUserActivity, {passive:true});
                document.addEventListener('touchstart', handleUserActivity, {passive:true});
                document.addEventListener('scroll', handleUserActivity, {passive:true});

                // Initialize suggestions on load if opened later
                setSuggestions();
                // scheduleNudge(); // Disabled: annoying popup in mobile
                scheduleLauncherAutoHide();
            })();
        </script>

