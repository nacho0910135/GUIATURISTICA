{
  "expo": {
    "name": "Descubriendo CR",
    "slug": "descubriendo-cr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "descubriendocr",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "cr.descubriendo.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "waze"
        ]
      }
    },
    "android": {
      "package": "cr.descubriendo.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#053326",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@rnmapbox/maps",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f7fbf8",
          "image": "./assets/brand/frog-flag.png",
          "imageWidth": 95,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0B0F12",
            "image": "./assets/brand/frog-flag.png"
          }
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Descubriendo CR accede a tus fotos para compartir avistamientos de fauna.",
          "cameraPermission": "Descubriendo CR usa la cámara para fotografiar fauna de forma responsable.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Descubriendo CR usa tu ubicación para recomendar destinos cercanos y calcular rutas."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "ferries"
        }
      ],
      "react-native-google-mobile-ads"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
