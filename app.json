{
  "expo": {
    "name": "Descubriendo CR",
    "slug": "descubriendo-cr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "descubriendocr",
    "userInterfaceStyle": "automatic",
    "ios": { "bundleIdentifier": "com.descubriendo.cr", "buildNumber": "1", "supportsTablet": true, "infoPlist": { "ITSAppUsesNonExemptEncryption": false, "LSApplicationQueriesSchemes": ["waze"] } },
    "android": {
      "package": "com.descubriendo.cr",
      "versionCode": 41,
      "blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW"],
      "permissions": ["CAMERA", "ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION", "RECORD_AUDIO"],
      "intentFilters": [{ "action": "VIEW", "autoVerify": true, "data": [{ "scheme": "descubriendocr" }], "category": ["BROWSABLE", "DEFAULT"] }],
      "adaptiveIcon": { "backgroundColor": "#053326", "foregroundImage": "./assets/images/android-icon-foreground.png", "monochromeImage": "./assets/images/android-icon-monochrome.png" },
      "predictiveBackGestureEnabled": true
    },
    "web": { "bundler": "metro", "output": "static", "favicon": "./assets/images/favicon.png" },
    "plugins": [
      ["expo-router", { "asyncRoutes": { "web": true, "default": false } }],
      ["expo-splash-screen", { "backgroundColor": "#FFFFFF", "image": "./assets/brand/splash-transparent.png", "imageWidth": 1 }],
      "expo-iap",
      "expo-font",
      ["expo-sensors", { "motionPermission": "Descubriendo CR usa los sensores de orientación para mostrar el rumbo real del teléfono en la brújula." }],
      ["expo-audio", { "microphonePermission": "Descubriendo CR usa el micrófono para grabar notas de voz en tus mensajes.", "recordAudioAndroid": true }],
      ["expo-image-picker", { "photosPermission": "Descubriendo CR accede a tus fotos para compartir imágenes en la comunidad y tus aportes." }],
      ["expo-location", { "locationWhenInUsePermission": "Descubriendo CR usa tu ubicación para recomendar destinos cercanos y calcular rutas." }]
    ],
    "runtimeVersion": { "policy": "appVersion" },
    "experiments": { "typedRoutes": true },
    "extra": { "router": { "asyncRoutes": { "web": true, "default": false } }, "eas": { "projectId": "f8b9f3a3-0224-4327-b108-711751fd4688" } },
    "owner": "nacho091011"
  }
}
