    "sync:buses:cantonal": "node --env-file=.env.local scripts/sync-cantonal-bus-routes.mjs",
    "sync:buses:fares": "node --env-file=.env.local scripts/sync-aresep-bus-fares.mjs",
    "check:planner": "node scripts/check-planner.mjs",
    "check:categories": "node --env-file=.env.local scripts/check-destination-categories.mjs",
    "check:marketplace": "node scripts/check-marketplace.mjs",
    "check:billing": "node scripts/check-billing.mjs",
    "check:play": "node scripts/check-google-play-readiness.mjs",
