    "check:trust": "node scripts/check-trust-metadata.mjs",
    "check:map": "node scripts/check-map-geojson.mjs",
    "build:android:aab": "npx eas-cli@latest build --platform android --profile production",
    "build:android:apk": "npx eas-cli@latest build --platform android --profile preview",
    "build:ios:ipa": "npx eas-cli@latest build --platform ios --profile production",
    "submit:android": "npx eas-cli@latest submit --platform android --profile production",
    "submit:ios": "npx eas-cli@latest submit --platform ios --profile production"
